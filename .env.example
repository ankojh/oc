# Shared LOCAL configuration for opusclip-hackathon.
# Prepared from the two implementations on 2026-10-11.
# Fill secrets here privately. Do not commit or include this file in submission ZIPs.
# Copy to .env (git-ignored). `npm start` at the repository root reads it and passes each
# service only the keys it uses. Precedence: non-empty shell environment > non-empty value
# here > service default. Blank entries are ignored and never mask credentials set elsewhere.

# REQUIRED for live audience research: Google Cloud key with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# OPTIONAL for both agents if local Codex authentication works.
# An OpenAI Platform API key; shared by both agents, not two different keys.
CODEX_API_KEY=

# OpusClip: mcp uses browser OAuth, rest uses the API key below.
OPUSCLIP_TRANSPORT=mcp
OPUSCLIP_API_KEY=
OPUSCLIP_ORG_ID=
OPUSCLIP_MCP_URL=https://mcp.opus.pro/mcp
OPUSCLIP_MCP_COMMAND="npx -y mcp-remote"
OPUSCLIP_API_BASE_URL=https://api.opus.pro/api

# Existing research service settings.
PORT=3101
YOUTUBE_COMMENTS_PER_VIDEO=100
YOUTUBE_MAX_RELATED_VIDEOS=5
YOUTUBE_RECENT_UPLOADS_TO_CONSIDER=15
CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_ISOLATE_MCP_SERVERS=true
CODEX_TIMEOUT_MS=240000
OPUSCLIP_CLIP_DURATION_SEC=0,90
OPUSCLIP_ASPECT_RATIO=portrait
OPUSCLIP_TIMERANGE_UNIT=verify
OPUSCLIP_POLL_INTERVAL_MS=20000
OPUSCLIP_MAX_POLL_MINUTES=180

# Existing reviewer settings. Fixture runs must never silently call a live model.
CLIP_REVIEW_PORT=3102
REVIEW_BACKEND=fixture
# Existing implementation default retained; change if unavailable to your account.
CLIP_REVIEW_MODEL=gpt-6-astra
CLIP_REVIEW_REASONING_EFFORT=medium
CLIP_REVIEW_TIMEOUT_MS=300000
CLIP_REVIEW_COPY_CODEX_LOGIN=1

# Integration launcher/coordinator settings.
INTEGRATION_PORT=3100
RESEARCH_SERVICE_URL=http://127.0.0.1:3101
REVIEW_SERVICE_URL=http://127.0.0.1:3102
