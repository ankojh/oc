# clip-review configuration (all optional). Names are prefixed so they never
# collide with audience-research (which uses PORT=3101 and CODEX_MODEL).
# Not auto-loaded: export them, or run `node --env-file=.env ...` / `set -a; . ./.env; set +a`.

CLIP_REVIEW_PORT=3102
# CLIP_REVIEW_DATA_DIR=/absolute/path     # default: clip-review/data (one JSON per review)

# auto    = fixture-mode research -> fixture backend (fails clearly if no response is bound to the content);
#           live research -> Codex. Fixture data never reaches a live model.
# codex   = always live Codex
# fixture = always replay a bound response (fails if none matches; refuses live research)
REVIEW_BACKEND=auto

CLIP_REVIEW_MODEL=gpt-6-astra
CLIP_REVIEW_REASONING_EFFORT=medium       # minimal | low | medium | high | xhigh
CLIP_REVIEW_TIMEOUT_MS=300000

# Isolated Codex home for the reviewer (no user AGENTS.md, memories, plugins, MCP servers).
# CLIP_REVIEW_CODEX_HOME=/absolute/path   # default: $HOME/.cache/clip-review/codex-home
# When no API key is set, copy the ChatGPT login from ~/.codex/auth.json into the isolated home (0600).
CLIP_REVIEW_COPY_CODEX_LOGIN=1
# CODEX_API_KEY=                          # alternative to ChatGPT login
