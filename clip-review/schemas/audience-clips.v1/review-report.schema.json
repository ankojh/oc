{
  "$id": "audience-clips.v1/review-report.schema.json",
  "title": "ReviewReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "audience-clips.v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "fixture"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "insufficient_evidence",
        "unverifiable"
      ]
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1
          },
          "clipId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "direct",
              "partial",
              "related_only",
              "no_match",
              "unverifiable"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "commentEvidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answerPassages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clipTranscriptSegmentId": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceStartMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sourceEndMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "clipTranscriptSegmentId",
                "quote",
                "sourceStartMs",
                "sourceEndMs"
              ]
            }
          },
          "contextWarnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceSegmentIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "explanation",
                "sourceSegmentIds"
              ]
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "questionId",
          "clipId",
          "verdict",
          "explanation",
          "commentEvidenceIds",
          "answerPassages",
          "contextWarnings",
          "limitations"
        ]
      }
    },
    "recommendations": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "clipId": {
            "type": "string",
            "minLength": 1
          },
          "questionIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rank",
          "clipId",
          "questionIds",
          "reason"
        ]
      }
    },
    "unansweredQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "not_found_in_generated_clips",
              "not_found_in_available_source",
              "cannot_assess"
            ]
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "questionId",
          "status",
          "explanation"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "mode",
    "status",
    "matches",
    "recommendations",
    "unansweredQuestions",
    "limitations"
  ]
}
