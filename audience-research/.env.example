# Copy to .env (git-ignored). Secrets stay server-side; never put them in the UI or logs.

# --- Server
PORT=3101
DATA_DIR=data

# --- YouTube Data API v3 (required for live research). Create a key in Google Cloud
# with "YouTube Data API v3" enabled. One research run costs roughly 4 + N quota units.
YOUTUBE_API_KEY=
YOUTUBE_COMMENTS_PER_VIDEO=100          # max 100 (one commentThreads page)
YOUTUBE_MAX_RELATED_VIDEOS=5            # max 5 same-channel videos besides the source
YOUTUBE_RECENT_UPLOADS_TO_CONSIDER=15   # recent uploads the agent may choose from

# --- Research agent (@openai/codex-sdk). Uses your local `codex login` by default.
CODEX_MODEL=                            # empty = Codex default model
CODEX_REASONING_EFFORT=                 # minimal | low | medium | high | xhigh (empty = default)
CODEX_ISOLATE_MCP_SERVERS=true          # disable your ~/.codex MCP servers for agent threads
CODEX_TIMEOUT_MS=240000
# CODEX_API_KEY=                        # optional: API-key auth instead of ChatGPT login

# --- OpusClip
OPUSCLIP_TRANSPORT=mcp                  # mcp (hosted OAuth MCP, preferred) | rest (API key)
OPUSCLIP_MCP_URL=https://mcp.opus.pro/mcp
OPUSCLIP_MCP_COMMAND=npx -y mcp-remote  # stdio bridge that performs the OAuth sign-in
OPUSCLIP_API_KEY=                       # required when OPUSCLIP_TRANSPORT=rest
OPUSCLIP_ORG_ID=                        # optional x-opus-org-id for multi-org accounts
OPUSCLIP_API_BASE_URL=https://api.opus.pro/api
OPUSCLIP_CLIP_DURATION_SEC=0,90         # documented buckets: 0,30 30,60 60,90 90,180 (REST default 0,90)
OPUSCLIP_ASPECT_RATIO=portrait          # portrait | landscape | square
OPUSCLIP_TIMERANGE_UNIT=verify          # verify (default) | ms | s — see README "Timestamp units"
OPUSCLIP_POLL_INTERVAL_MS=20000
OPUSCLIP_MAX_POLL_MINUTES=180
